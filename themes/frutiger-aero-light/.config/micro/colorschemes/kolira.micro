# Kolira base16 appearance only
color-link default "#1b1b1b,#ffffff"
color-link comment "#8a9cad"
color-link constant.string "#2f8a2f"
color-link constant.number "#d06b00"
color-link constant "#d06b00"
color-link statement "#6b4fbb"
color-link type "#a07800"
color-link identifier "#0a8ca6"
color-link special "#0066cc"
color-link symbol "#0a8ca6"
color-link error "#c42b1c"
color-link line-number "#8a9cad"
color-link selection "#1b1b1b,#d9ebf9"
color-link statusline "#1b1b1b,#f0f6fc"
