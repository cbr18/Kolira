/* BEGIN kolira colours */
*{
    background: #f0f6fc;
    foreground: #1b1b1b;
    background-color: #f0f6fc;
    color: #1b1b1b;
    border: 1px solid #d9ebf9;
    border-radius: 4px;
    padding: 8px;
}
#input { background-color: #8a9cad; color: #1b1b1b; border-color: #3399e6; }
#entry:selected { background-color: #3399e6; color: #000000; }
#text:selected { color: #000000; }
/* END kolira colours */
