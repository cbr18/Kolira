{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "display": {
          "separator": " ➜  ",
          "color": {
              "separator": "#C678DD"
          }
    },
    "modules": [
        "break",
        "break",
        "break",
         {
            "type": "os",
            "key": "OS   ",
            "keyColor": "38;2;97;175;239",  // #61AFEF
        },
        {
            "type": "kernel",
            "key": " ├  ",
            "keyColor": "38;2;127;167;240",
        },
        {
            "type": "packages",
            "key": " ├ 󰏖 ",
            "keyColor": "38;2;155;159;235",
        },
        {
            "type": "uptime",
            "key": " ├  ",
            "keyColor": "38;2;183;141;227",
        },
        {
            "type": "command",
            "key": " ├ 󰔟 ",
            "keyColor": "38;2;198;120;221",
            "text": "d=2026-03-10; printf '%s (%dd)' \"$d\" $(( ($(date +%s) - $(date -d \"$d\" +%s)) / 86400 ))",
            "format": "{}",
        },
        {
            "type": "shell",
            "key": " └  ",
            "keyColor": "38;2;207;113;202",
        },
        "break",
        {
            "type": "wm",
            "key": "WM   ",
            "keyColor": "38;2;198;120;221",
        },
        {
            "type": "wmtheme",
            "key": " ├ 󰉼 ",
            "keyColor": "38;2;207;113;202",
        },
        {
            "type": "icons",
            "key": " ├ 󰀻 ",
            "keyColor": "38;2;222;103;179",
        },
        {
            "type": "cursor",
            "key": " ├  ",
            "keyColor": "38;2;239;97;151",
        },
        {
            "type": "terminal",
            "key": " ├  ",
            "keyColor": "38;2;255;100;113",
        },
        {
            "type": "terminalfont",
            "key": " └  ",
            "keyColor": "38;2;198;120;221",
        },
        "break",
        {
            "type": "host",
            "format": "ASUS TUF Gaming A15",
            "key": "PC   ",
            "keyColor": "38;2;149;255;164",
        },
        {
            "type": "cpu",
            "format": "{1} ({3}) @ {7}",
            "key": " ├  ",
            "keyColor": "38;2;97;175;239",
        },
        {
            "type": "gpu",
            "format": "{2}",
            "key": " ├ 󰢮 ",
            "keyColor": "38;2;155;159;235",
        },
        {
            "type": "memory",
            "key": " ├  ",
            "keyColor": "38;2;198;120;221",
        },
        {
            "type": "swap",
            "key": " ├ 󰓡 ",
            "keyColor": "38;2;239;97;151",
        },
        {
            "type": "disk",
            "folders": "/:/home:/run/media/tom0:/run/media/tom1",
            "format": "{size-used} / {size-total} ({size-percentage}) - {filesystem}",
            "key": " ├ 󰋊 ",
            "keyColor": "38;2;255;100;113",
        },
        {
            "type": "battery",
            "key": " ├  ",
            "keyColor": "38;2;183;141;227",
        },
        {
            "type": "display",
            "compactType": "original-with-refresh-rate",
            "key": " └  ",
            "keyColor": "38;2;97;175;239",
        },
        "break",
        {
            "type": "colors",
            "key": "CLR  ",
            "keyColor": "38;2;198;120;221",
            "symbol": "circle"
        },
        "break",
        "break",
    ]
}
