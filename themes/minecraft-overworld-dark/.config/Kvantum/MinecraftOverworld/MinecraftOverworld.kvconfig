[%General]
author=Kolira contributors
comment=Original Minecraft-inspired stone and oak controls; MIT
x11drag=true
composite=false
translucent_windows=false
blurring=false
popup_blurring=false
animate_states=false
no_window_pattern=true
menu_shadow_depth=0
tooltip_shadow_depth=0
scroll_width=16
scroll_arrows=false
scroll_min_extent=32
slider_width=8
slider_handle_width=18
slider_handle_length=22
check_size=18
progressbar_thickness=12
small_icon_size=16
button_icon_size=16
layout_spacing=6

[GeneralColors]
window.color=#383838
base.color=#252525
alt.base.color=#404040
button.color=#555555
light.color=#929292
mid.light.color=#747474
dark.color=#202020
mid.color=#555555
highlight.color=#70B237
inactive.highlight.color=#555555
tooltip.base.color=#282828
text.color=#CCCCCC
window.text.color=#CCCCCC
button.text.color=#F0F0F0
disabled.text.color=#999999
tooltip.text.color=#F0F0F0
highlight.text.color=#000000
link.color=#55D6D0
link.visited.color=#A98558

[Hacks]
transparent_dolphin_view=false
transparent_pcmanfm_sidepane=false
blur_translucent=false
respect_darkness=true

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
interior=true
interior.element=button
text.normal.color=#F0F0F0
text.focus.color=#F0F0F0
text.press.color=#F0F0F0
text.toggle.color=#000000
text.shadow=0
text.margin=4
text.margin.top=5
text.margin.bottom=5
text.margin.left=8
text.margin.right=8
text.iconspacing=4
indicator.element=arrow
indicator.size=10

[PanelButtonTool]
inherits=PanelButtonCommand
frame.element=button
interior.element=button

[GenericFrame]
inherits=PanelButtonCommand
frame.element=common
interior.element=common

[LineEdit]
inherits=PanelButtonCommand
frame.element=lineedit
interior.element=lineedit

[Tab]
inherits=PanelButtonCommand
frame.element=tab
interior.element=tab

[TabFrame]
inherits=PanelButtonCommand
frame.element=common
interior.element=common

[Toolbar]
inherits=PanelButtonCommand
frame.element=wood
interior.element=wood

[MenuBar]
inherits=PanelButtonCommand
frame.element=wood
interior.element=wood

[Menu]
inherits=PanelButtonCommand
frame.element=menu
interior.element=menu

[MenuItem]
inherits=PanelButtonCommand
frame.element=menuitem
interior.element=menuitem
text.focus.color=#000000
text.toggle.color=#000000

[MenuBarItem]
inherits=PanelButtonCommand
frame.element=menuitem
interior.element=menuitem
text.focus.color=#000000
text.toggle.color=#000000

[ToolTip]
inherits=PanelButtonCommand
frame.element=tooltip
interior.element=tooltip

[Slider]
inherits=PanelButtonCommand
frame.element=groove
interior.element=groove

[SliderCursor]
inherits=PanelButtonCommand
frame.element=handle
interior.element=handle

[Progressbar]
inherits=PanelButtonCommand
frame.element=groove
interior.element=groove

[ProgressbarContents]
inherits=PanelButtonCommand
frame.element=progress
interior.element=progress
text.focus.color=#000000
text.toggle.color=#000000

[ItemView]
inherits=PanelButtonCommand
frame.element=itemview
interior.element=itemview
text.focus.color=#000000
text.toggle.color=#000000

[HeaderSection]
inherits=PanelButtonCommand
frame.element=wood
interior.element=wood

[ScrollbarGroove]
inherits=PanelButtonCommand
frame.element=groove
interior.element=groove

[ScrollbarSlider]
inherits=PanelButtonCommand
frame.element=handle
interior.element=handle

[GroupBox]
inherits=PanelButtonCommand
frame.element=common
interior.element=common

[StatusBar]
inherits=PanelButtonCommand
frame.element=wood
interior.element=wood

[Window]
inherits=PanelButtonCommand
frame.element=window
interior.element=window

[Dialog]
inherits=PanelButtonCommand
frame.element=window
interior.element=window

[CheckBox]
inherits=PanelButtonCommand
frame=false
interior.element=checkbox

[RadioButton]
inherits=PanelButtonCommand
frame=false
interior.element=radio

[IndicatorArrow]
indicator.element=arrow
indicator.size=10

[DropDownButton]
inherits=PanelButtonCommand
indicator.element=arrow-down
