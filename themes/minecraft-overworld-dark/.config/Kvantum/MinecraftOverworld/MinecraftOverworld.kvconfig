[%General]
author=Minecraft Overworld Dark Theme
comment=Minecraft Java Edition inspired Kvantum theme
x11drag=menubar_and_primary_toolbar
alt_mnemonic=true
left_tabs=true
attach_active_tab=true
mirror_doc_tabs=true
group_toolbar_buttons=false
toolbar_item_spacing=4
toolbar_interior_spacing=6
spread_progressbar=true
composite=false
menu_shadow_depth=0
menu_separator_height=4
tooltip_shadow_depth=0
splitter_width=4
scroll_width=16
scroll_arrows=false
scroll_min_extent=40
slider_width=14
slider_handle_width=20
slider_handle_length=24
center_toolbar_handle=true
check_size=20
textless_progressbar=false
progressbar_thickness=12
menubar_mouse_tracking=true
toolbutton_style=1
click_behavior=0

[Button]
horizontalPadding=10
verticalPadding=10
textOffset=0,0
iconOnlySize=32

[Menu]
horizontalPadding=10
verticalPadding=10
textOffset=0,0
iconOnlySize=32
arrowSize=12
submenuArrowSize=12
itemHeight=32
checkableIndicatorSize=20

[ToolButton]
horizontalPadding=10
verticalPadding=10
textOffset=0,0
iconOnlySize=32

[ComboBox]
horizontalPadding=10
verticalPadding=6
textOffset=0,0
arrowSize=16

[ItemView]
itemHeight=32
textOffset=8,0
indicatorSize=20
indicatorOffset=8,0
decorationSize=20
decorationOffset=8,0

[ScrollBar]
horizontalPadding=0
verticalPadding=0
handleLength=120
handleWidth=14
handleOffset=0
minLength=40

[Slider]
horizontalPadding=10
verticalPadding=10
handleLength=24
handleWidth=14

[SpinBox]
horizontalPadding=10
verticalPadding=6
textOffset=0,0

[LineEdit]
horizontalPadding=10
verticalPadding=10
textOffset=0,0

[TextEdit]
horizontalPadding=10
verticalPadding=10

[ProgressBar]
horizontalPadding=6
verticalPadding=6

[TabWidget]
tabBarShape=roundedNorth
tabBarAutoHide=false
tabShape=roundedNorth
elideMode=right
closeButtonOnTab=true
tabBarAlignment=center
tabBarBaseColor=38,38,38
tabBarBaseColorSelected=112,178,55
tabBarBaseColorHover=85,85,85
tabBarTextColor=204,204,204
tabBarTextColorSelected=0,0,0
tabBarTextColorHover=204,204,204
tabBarBorderColor=116,116,116

[Window]
activeBackground=38,38,38
inactiveBackground=33,33,33
borderColor=116,116,116
borderWidth=4
margin=0
dropShadow=false
