element { background-color: transparent; }
element { text-color: #cccccc; }
element alternate.active { background-color: #252525; }
element alternate.active { text-color: #cccccc; }
element alternate.normal { background-color: #252525; }
element alternate.normal { text-color: #cccccc; }
element alternate.urgent { background-color: #252525; }
element alternate.urgent { text-color: #cccccc; }
element normal.active { background-color: #252525; }
element normal.active { text-color: #cccccc; }
element normal.normal { background-color: #252525; }
element normal.normal { text-color: #cccccc; }
element normal.urgent { background-color: #252525; }
element normal.urgent { text-color: #cccccc; }
element selected { background-color: #70b237; }
element selected { text-color: #252525; }
element selected.active { background-color: #70b237; }
element selected.active { text-color: #252525; }
element selected.normal { background-color: #70b237; }
element selected.normal { text-color: #252525; }
element selected.urgent { background-color: #70b237; }
element selected.urgent { text-color: #252525; }
element-icon { background-color: transparent; }
element-text { background-color: transparent; }
element-text { text-color: inherit; }
entry { cursor-color: #70b237; }
entry { text-color: #cccccc; }
inputbar { background-color: #383838; }
listview { background-color: transparent; }
mainbox { background-color: transparent; }
prompt { text-color: #70b237; }
window { background-color: #252525; }
window { border-color: #404040; }
window { text-color: #cccccc; }
