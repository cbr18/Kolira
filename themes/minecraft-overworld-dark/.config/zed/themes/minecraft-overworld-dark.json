{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Minecraft Overworld Dark",
  "author": "Kolira contributors",
  "themes": [
    {
      "name": "Minecraft Overworld Dark",
      "appearance": "dark",
      "style": {
        "background": "#383838",
        "surface.background": "#383838",
        "elevated_surface.background": "#404040",
        "text": "#CCCCCC",
        "text.muted": "#999999",
        "text.accent": "#93CE4F",
        "border": "#747474",
        "border.focused": "#70B237",
        "editor.background": "#252525",
        "editor.foreground": "#CCCCCC",
        "editor.gutter.background": "#252525",
        "editor.line_number": "#999999",
        "editor.active_line_number": "#93CE4F",
        "editor.active_line.background": "#383838",
        "tab.active_background": "#555555",
        "tab.inactive_background": "#383838",
        "status_bar.background": "#383838",
        "toolbar.background": "#383838",
        "terminal.background": "#252525",
        "terminal.foreground": "#CCCCCC",
        "players": [
          {
            "cursor": "#70B237",
            "background": "#70B237",
            "selection": "#70B23750"
          }
        ],
        "syntax": {
          "comment": {
            "color": "#999999"
          },
          "keyword": {
            "color": "#93CE4F"
          },
          "string": {
            "color": "#F6C453"
          },
          "number": {
            "color": "#A98558"
          },
          "function": {
            "color": "#55D6D0"
          },
          "type": {
            "color": "#93CE4F"
          },
          "variable": {
            "color": "#CCCCCC"
          },
          "constant": {
            "color": "#F6C453"
          },
          "operator": {
            "color": "#CCCCCC"
          }
        }
      }
    }
  ]
}
