{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Kolira minecraft-overworld-dark",
  "author": "Kolira contributors",
  "themes": [
    {
      "name": "Kolira minecraft-overworld-dark",
      "appearance": "dark",
      "style": {
        "background": "#252525",
        "surface.background": "#383838",
        "elevated_surface.background": "#383838",
        "panel.background": "#383838",
        "text": "#cccccc",
        "text.muted": "#c0c0c0",
        "text.accent": "#a2cd7d",
        "icon.accent": "#a2cd7d",
        "link_text.hover": "#a2cd7d",
        "border": "#404040",
        "border.focused": "#a2cd7d",
        "panel.focused_border": "#a2cd7d",
        "pane.focused_border": "#a2cd7d",
        "element.hover": "#3c4238",
        "element.selected": "#414c38",
        "ghost_element.hover": "#3c4238",
        "ghost_element.selected": "#414c38",
        "created": "#a2cd7d",
        "modified": "#e7c77d",
        "warning": "#e7c77d",
        "deleted": "#f7aea9",
        "conflict": "#f6c453",
        "renamed": "#55d6d0",
        "error": "#f7aea9",
        "success": "#a2cd7d",
        "editor.background": "#252525",
        "editor.foreground": "#cccccc",
        "editor.gutter.background": "#252525",
        "editor.line_number": "#c0c0c0",
        "editor.active_line_number": "#cccccc",
        "editor.active_line.background": "#383838",
        "tab.active_background": "#252525",
        "tab.inactive_background": "#383838",
        "toolbar.background": "#383838",
        "status_bar.background": "#383838",
        "terminal.background": "#252525",
        "terminal.foreground": "#cccccc",
        "search.match_background": "#564e3b",
        "players": [
          {
            "cursor": "#a2cd7d",
            "background": "#a2cd7d",
            "selection": "#333e28"
          }
        ],
        "syntax": {
          "comment": {
            "color": "#c0c0c0"
          },
          "string": {
            "color": "#a2cd7d"
          },
          "keyword": {
            "color": "#d1bda5"
          },
          "number": {
            "color": "#f6c453"
          },
          "function": {
            "color": "#55d6d0"
          },
          "type": {
            "color": "#e7c77d"
          }
        }
      }
    }
  ]
}
