{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Kolira minecraft-overworld-dark",
  "author": "Kolira contributors",
  "themes": [
    {
      "name": "Kolira minecraft-overworld-dark",
      "appearance": "dark",
      "style": {
        "background": "#252525",
        "surface.background": "#383838",
        "elevated_surface.background": "#383838",
        "text": "#cccccc",
        "text.muted": "#999999",
        "text.accent": "#70b237",
        "border": "#404040",
        "border.focused": "#70b237",
        "editor.background": "#252525",
        "editor.foreground": "#cccccc",
        "editor.gutter.background": "#252525",
        "editor.line_number": "#999999",
        "editor.active_line_number": "#cccccc",
        "editor.active_line.background": "#383838",
        "tab.active_background": "#252525",
        "tab.inactive_background": "#383838",
        "toolbar.background": "#383838",
        "status_bar.background": "#383838",
        "terminal.background": "#252525",
        "terminal.foreground": "#cccccc",
        "players": [
          {
            "cursor": "#70b237",
            "background": "#70b237",
            "selection": "#70b23750"
          }
        ],
        "syntax": {
          "comment": {
            "color": "#999999"
          },
          "string": {
            "color": "#70b237"
          },
          "keyword": {
            "color": "#a98558"
          },
          "number": {
            "color": "#f6c453"
          },
          "function": {
            "color": "#55d6d0"
          },
          "type": {
            "color": "#e7c77d"
          }
        }
      }
    }
  ]
}
