{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Kolira glass",
  "author": "Kolira contributors",
  "themes": [
    {
      "name": "Kolira glass",
      "appearance": "dark",
      "style": {
        "background": "#141618",
        "surface.background": "#202326",
        "elevated_surface.background": "#202326",
        "panel.background": "#202326",
        "text": "#fcfcfc",
        "text.muted": "#a1a9b1",
        "text.accent": "#47b2ea",
        "icon.accent": "#47b2ea",
        "link_text.hover": "#47b2ea",
        "border": "#393b3c",
        "border.focused": "#47b2ea",
        "panel.focused_border": "#47b2ea",
        "pane.focused_border": "#47b2ea",
        "element.hover": "#222e36",
        "element.selected": "#253945",
        "ghost_element.hover": "#222e36",
        "ghost_element.selected": "#253945",
        "created": "#4cbc7b",
        "modified": "#f8a458",
        "warning": "#f8a458",
        "deleted": "#e98f98",
        "conflict": "#f88d2e",
        "renamed": "#4faff6",
        "error": "#e98f98",
        "success": "#4cbc7b",
        "editor.background": "#141618",
        "editor.foreground": "#fcfcfc",
        "editor.gutter.background": "#141618",
        "editor.line_number": "#a1a9b1",
        "editor.active_line_number": "#fcfcfc",
        "editor.active_line.background": "#202326",
        "tab.active_background": "#141618",
        "tab.inactive_background": "#202326",
        "toolbar.background": "#202326",
        "status_bar.background": "#202326",
        "terminal.background": "#141618",
        "terminal.foreground": "#fcfcfc",
        "search.match_background": "#4d3a28",
        "players": [
          {
            "cursor": "#47b2ea",
            "background": "#47b2ea",
            "selection": "#1b313e"
          }
        ],
        "syntax": {
          "comment": {
            "color": "#a1a9b1"
          },
          "string": {
            "color": "#4cbc7b"
          },
          "keyword": {
            "color": "#c29ad2"
          },
          "number": {
            "color": "#f88d2e"
          },
          "function": {
            "color": "#4faff6"
          },
          "type": {
            "color": "#f8a458"
          }
        }
      }
    }
  ]
}
