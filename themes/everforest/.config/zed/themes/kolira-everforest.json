{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Kolira everforest",
  "author": "Kolira contributors",
  "themes": [
    {
      "name": "Kolira everforest",
      "appearance": "dark",
      "style": {
        "background": "#232a2e",
        "surface.background": "#2d353b",
        "elevated_surface.background": "#2d353b",
        "panel.background": "#2d353b",
        "text": "#d3c6aa",
        "text.muted": "#bcc3be",
        "text.accent": "#b3c992",
        "icon.accent": "#b3c992",
        "link_text.hover": "#b3c992",
        "border": "#3f4342",
        "border.focused": "#b3c992",
        "panel.focused_border": "#b3c992",
        "pane.focused_border": "#b3c992",
        "element.hover": "#374041",
        "element.selected": "#414b46",
        "ghost_element.hover": "#374041",
        "ghost_element.selected": "#414b46",
        "created": "#b3c992",
        "modified": "#d8c08e",
        "warning": "#d8c08e",
        "deleted": "#f0b2b3",
        "conflict": "#dbbd80",
        "renamed": "#9bcac4",
        "error": "#f0b2b3",
        "success": "#b3c992",
        "editor.background": "#232a2e",
        "editor.foreground": "#d3c6aa",
        "editor.gutter.background": "#232a2e",
        "editor.line_number": "#bcc3be",
        "editor.active_line_number": "#d3c6aa",
        "editor.active_line.background": "#2d353b",
        "tab.active_background": "#232a2e",
        "tab.inactive_background": "#2d353b",
        "toolbar.background": "#2d353b",
        "status_bar.background": "#2d353b",
        "terminal.background": "#232a2e",
        "terminal.foreground": "#d3c6aa",
        "search.match_background": "#505046",
        "players": [
          {
            "cursor": "#b3c992",
            "background": "#b3c992",
            "selection": "#3b453d"
          }
        ],
        "syntax": {
          "comment": {
            "color": "#bcc3be"
          },
          "string": {
            "color": "#b3c992"
          },
          "keyword": {
            "color": "#e1b5ca"
          },
          "number": {
            "color": "#dbbd80"
          },
          "function": {
            "color": "#9bcac4"
          },
          "type": {
            "color": "#d8c08e"
          }
        }
      }
    }
  ]
}
