/* BEGIN kolira colours */
*{
    background: #21222c;
    foreground: #f8f8f2;
    background-color: #21222c;
    color: #f8f8f2;
    border: 1px solid #44475a;
    border-radius: 4px;
    padding: 8px;
}
#input { background-color: #6272a4; color: #f8f8f2; border-color: #bd93f9; }
#entry:selected { background-color: #bd93f9; color: #ffffff; }
#text:selected { color: #ffffff; }
/* END kolira colours */
