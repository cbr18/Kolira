{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
    	"source": "~/.config/fastfetch/logo",
        "color": {
            "1": "#315B7C",
            "2": "#244F72",
            "3": "#68406F",
            "4": "#573261",
            "5": "#586D47",
            "6": "#842B2F"
        },
    },
    "display": {
          "separator": " ➜  ",
          "color": {
              "separator": "#586D47",
              "output": "#2F2A24"
          }
    },
    "modules": [
        "break",
        "break",
        "break",
         {
            "type": "os",
            "key": "OS   ",
            "keyColor": "38;2;49;91;124",  // #315B7C
        },
        {
            "type": "kernel",
            "key": " ├  ",
            "keyColor": "38;2;36;79;114",
        },
        {
            "type": "packages",
            "key": " ├ 󰏖 ",
            "keyColor": "38;2;104;64;111",
        },
        {
            "type": "uptime",
            "key": " ├  ",
            "keyColor": "38;2;87;50;97",
        },
        {
            "type": "command",
            "key": " ├ 󰔟 ",
            "keyColor": "38;2;88;109;71",
            "text": "d=2026-03-10; printf '%s (%dd)' \"$d\" $(( ($(date +%s) - $(date -d \"$d\" +%s)) / 86400 ))",
            "format": "{}",
        },
        {
            "type": "shell",
            "key": " └  ",
            "keyColor": "38;2;95;63;104",
        },
        "break",
        {
            "type": "wm",
            "key": "WM   ",
            "keyColor": "38;2;88;109;71",
        },
        {
            "type": "wmtheme",
            "key": " ├ 󰉼 ",
            "keyColor": "38;2;95;63;104",
        },
        {
            "type": "icons",
            "key": " ├ 󰀻 ",
            "keyColor": "38;2;132;42;45",
        },
        {
            "type": "cursor",
            "key": " ├  ",
            "keyColor": "38;2;111;32;38",
        },
        {
            "type": "terminal",
            "key": " ├  ",
            "keyColor": "38;2;132;43;47",
        },
        {
            "type": "terminalfont",
            "key": " └  ",
            "keyColor": "38;2;88;109;71",
        },
        "break",
        {
            "type": "host",
            "format": "ASUS TUF Gaming A15",
            "key": "PC   ",
            "keyColor": "38;2;56;99;59",
        },
        {
            "type": "cpu",
            "format": "{1} ({3}) @ {7}",
            "key": " ├  ",
            "keyColor": "38;2;49;91;124",
        },
        {
            "type": "gpu",
            "format": "{2}",
            "key": " ├ 󰢮 ",
            "keyColor": "38;2;104;64;111",
        },
        {
            "type": "memory",
            "key": " ├  ",
            "keyColor": "38;2;88;109;71",
        },
        {
            "type": "swap",
            "key": " ├ 󰓡 ",
            "keyColor": "38;2;111;32;38",
        },
        {
            "type": "disk",
            "folders": "/:/home:/run/media/tom0:/run/media/tom1",
            "format": "{size-used} / {size-total} ({size-percentage}) - {filesystem}",
            "key": " ├ 󰋊 ",
            "keyColor": "38;2;132;43;47",
        },
        {
            "type": "battery",
            "key": " ├  ",
            "keyColor": "38;2;87;50;97",
        },
        {
            "type": "display",
            "compactType": "original-with-refresh-rate",
            "key": " └  ",
            "keyColor": "38;2;49;91;124",
        },
        "break",
        {
            "type": "colors",
            "key": "CLR  ",
            "keyColor": "38;2;88;109;71",
            "symbol": "circle"
        },
        "break",
        "break",
    ]
}
