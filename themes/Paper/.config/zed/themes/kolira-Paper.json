{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Kolira Paper",
  "author": "Kolira contributors",
  "themes": [
    {
      "name": "Kolira Paper",
      "appearance": "light",
      "style": {
        "background": "#fffbf4",
        "surface.background": "#f6f0e6",
        "elevated_surface.background": "#f6f0e6",
        "panel.background": "#f6f0e6",
        "text": "#2f2a24",
        "text.muted": "#5c564e",
        "text.accent": "#4b5d3c",
        "icon.accent": "#4b5d3c",
        "link_text.hover": "#4b5d3c",
        "border": "#dedad3",
        "border.focused": "#4b5d3c",
        "panel.focused_border": "#4b5d3c",
        "pane.focused_border": "#4b5d3c",
        "element.hover": "#e9e6d9",
        "element.selected": "#dddbcd",
        "ghost_element.hover": "#e9e6d9",
        "ghost_element.selected": "#dddbcd",
        "created": "#37613a",
        "modified": "#593f25",
        "warning": "#593f25",
        "deleted": "#842a2d",
        "conflict": "#704a25",
        "renamed": "#3f5133",
        "error": "#842a2d",
        "success": "#37613a",
        "editor.background": "#fffbf4",
        "editor.foreground": "#2f2a24",
        "editor.gutter.background": "#fffbf4",
        "editor.line_number": "#5c564e",
        "editor.active_line_number": "#2f2a24",
        "editor.active_line.background": "#f6f0e6",
        "tab.active_background": "#fffbf4",
        "tab.inactive_background": "#f6f0e6",
        "toolbar.background": "#f6f0e6",
        "status_bar.background": "#f6f0e6",
        "terminal.background": "#fffbf4",
        "terminal.foreground": "#2f2a24",
        "search.match_background": "#d6ccc0",
        "players": [
          {
            "cursor": "#4b5d3c",
            "background": "#4b5d3c",
            "selection": "#e1e1d5"
          }
        ],
        "syntax": {
          "comment": {
            "color": "#5c564e"
          },
          "string": {
            "color": "#37613a"
          },
          "keyword": {
            "color": "#5e3f66"
          },
          "number": {
            "color": "#704a25"
          },
          "function": {
            "color": "#3f5133"
          },
          "type": {
            "color": "#593f25"
          }
        }
      }
    }
  ]
}
