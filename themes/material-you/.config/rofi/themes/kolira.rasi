element { background-color: transparent; }
element { text-color: #d0d1d3; }
element alternate.active { background-color: #1e1f23; }
element alternate.active { text-color: #d0d1d3; }
element alternate.normal { background-color: #1e1f23; }
element alternate.normal { text-color: #d0d1d3; }
element alternate.urgent { background-color: #1e1f23; }
element alternate.urgent { text-color: #d0d1d3; }
element normal.active { background-color: #1e1f23; }
element normal.active { text-color: #d0d1d3; }
element normal.normal { background-color: #1e1f23; }
element normal.normal { text-color: #d0d1d3; }
element normal.urgent { background-color: #1e1f23; }
element normal.urgent { text-color: #d0d1d3; }
element selected { background-color: #7aaeef; }
element selected { text-color: #1e1f23; }
element selected.active { background-color: #7aaeef; }
element selected.active { text-color: #1e1f23; }
element selected.normal { background-color: #7aaeef; }
element selected.normal { text-color: #1e1f23; }
element selected.urgent { background-color: #7aaeef; }
element selected.urgent { text-color: #1e1f23; }
element-icon { background-color: transparent; }
element-text { background-color: transparent; }
element-text { text-color: inherit; }
entry { cursor-color: #7aaeef; }
entry { text-color: #d0d1d3; }
inputbar { background-color: #2a2b30; }
listview { background-color: transparent; }
mainbox { background-color: transparent; }
prompt { text-color: #7aaeef; }
window { background-color: #1e1f23; }
window { border-color: #3c3d41; }
window { text-color: #d0d1d3; }
