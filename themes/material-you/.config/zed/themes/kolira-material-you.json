{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Kolira material-you",
  "author": "Kolira contributors",
  "themes": [
    {
      "name": "Kolira material-you",
      "appearance": "dark",
      "style": {
        "background": "#1e1f23",
        "surface.background": "#2a2b30",
        "elevated_surface.background": "#2a2b30",
        "panel.background": "#2a2b30",
        "text": "#d0d1d3",
        "text.muted": "#b1b1b3",
        "text.accent": "#83b4f0",
        "icon.accent": "#83b4f0",
        "link_text.hover": "#83b4f0",
        "border": "#3c3d41",
        "border.focused": "#83b4f0",
        "panel.focused_border": "#83b4f0",
        "pane.focused_border": "#83b4f0",
        "element.hover": "#30353f",
        "element.selected": "#37404f",
        "ghost_element.hover": "#30353f",
        "ghost_element.selected": "#37404f",
        "created": "#89be7d",
        "modified": "#cab45d",
        "warning": "#cab45d",
        "deleted": "#eb9c95",
        "conflict": "#e3a376",
        "renamed": "#83b4f0",
        "error": "#eb9c95",
        "success": "#89be7d",
        "editor.background": "#1e1f23",
        "editor.foreground": "#d0d1d3",
        "editor.gutter.background": "#1e1f23",
        "editor.line_number": "#b1b1b3",
        "editor.active_line_number": "#d0d1d3",
        "editor.active_line.background": "#2a2b30",
        "tab.active_background": "#1e1f23",
        "tab.inactive_background": "#2a2b30",
        "toolbar.background": "#2a2b30",
        "status_bar.background": "#2a2b30",
        "terminal.background": "#1e1f23",
        "terminal.foreground": "#d0d1d3",
        "search.match_background": "#494432",
        "players": [
          {
            "cursor": "#83b4f0",
            "background": "#83b4f0",
            "selection": "#2f3948"
          }
        ],
        "syntax": {
          "comment": {
            "color": "#b1b1b3"
          },
          "string": {
            "color": "#89be7d"
          },
          "keyword": {
            "color": "#d79ed2"
          },
          "number": {
            "color": "#e3a376"
          },
          "function": {
            "color": "#83b4f0"
          },
          "type": {
            "color": "#cab45d"
          }
        }
      }
    }
  ]
}
